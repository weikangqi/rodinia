# 用于 Android NDK arm64-v8a 交叉编译 OpenCL 程序的 Make.user 示例
# 请根据实际 NDK 路径和环境变量调整

# NDK 路径（假设 ANDROID_NDK_HOME 已设置）
NDK ?= $(ANDROID_NDK_HOME)
SYSROOT := $(NDK)/toolchains/llvm/prebuilt/linux-x86_64/sysroot
CROSS_PREFIX := aarch64-linux-android
API_LEVEL := 21

CC := $(NDK)/toolchains/llvm/prebuilt/linux-x86_64/bin/$(CROSS_PREFIX)$(API_LEVEL)-clang
CXX := $(NDK)/toolchains/llvm/prebuilt/linux-x86_64/bin/$(CROSS_PREFIX)$(API_LEVEL)-clang++
AR := $(NDK)/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar
STRIP := $(NDK)/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip

CFLAGS += --sysroot=$(SYSROOT) -fPIE -pie -DCL_TARGET_OPENCL_VERSION=120 -O2 -Wall -Wno-implicit-function-declaration -Wno-narrowing -I$(SYSROOT)/usr/include
CXXFLAGS += --sysroot=$(SYSROOT) -fPIE -pie -DCL_TARGET_OPENCL_VERSION=120 -O2 -Wall -Wno-narrowing -I$(SYSROOT)/usr/include
LDFLAGS += --sysroot=$(SYSROOT) -fPIE -pie -L$(PWD)/../build-android/lib -Wl,-rpath,/vendor/lib64

# 链接 OpenCL 动态库（需提前从设备pull到build-android/lib）
LDLIBS += -lOpenCL

# C++ 运行时（运行时需push libc++_shared.so 到设备）
LDFLAGS += -L$(SYSROOT)/usr/lib/$(CROSS_PREFIX)/$(API_LEVEL) -lc++_shared
